{
  "id": "provider-a-web", "version": 1,
  "metadata": {
    "originalQuery": "$.search_information.query",
    "totalResultsEstimate": "$.search_information.total_results",
    "nextPageUrl": "$.pagination.next"
  },
  "sections": [
    { "id": "organic", "kind": "items", "path": "$.organic_results[*]", "resultType": "organic", "position": "fields",
      "fields": {
        "title": ["title", "name"],
        "url": ["link", "url"],
        "snippet": ["snippet", "description"],
        "rankInGroup": { "from": ["position", "rank"], "convert": "int" },
        "domain": { "from": ["link", "url"], "convert": "host" }
      } },
    { "id": "paa", "kind": "features", "path": "$.related_questions[*]", "resultType": "people_also_ask",
      "fields": { "question": "question", "answer": "answer", "sourceUrl": "link" } }
  ]
}
