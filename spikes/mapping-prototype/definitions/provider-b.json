{
  "id": "provider-b-web", "version": 1,
  "metadata": {
    "originalQuery": "$.meta.q",
    "providerReportedMillis": { "from": "$.meta.took_ms", "convert": "int" }
  },
  "sections": [
    { "id": "organic", "kind": "items", "path": "$.results[*]", "resultType": "organic", "position": "index",
      "fields": {
        "title": ["title", "name"],
        "url": { "from": ["link", "url"], "required": true },
        "snippet": { "from": ["snippet", "description"], "convert": "stripHtml" },
        "additionalSnippets": "extra",
        "rankAbsolute": { "from": "rank", "convert": "int" },
        "domain": { "from": "url", "convert": "host" },
        "b:thumbnail": "thumbnail.src"
      } },
    { "id": "infobox", "kind": "features", "path": "$.info_box", "resultType": "knowledge_panel",
      "fields": { "title": "label", "description": "long_desc" } },
    { "id": "experimental", "kind": "features", "path": "$.experimental_block", "resultType": "experimental_block" }
  ]
}
