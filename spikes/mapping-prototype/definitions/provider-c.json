{
  "id": "provider-c-web", "version": 1,
  "metadata": {
    "originalQuery": "$.tasks[0].result[0].keyword",
    "totalResultsEstimate": "$.tasks[0].result[0].se_results_count",
    "providerRequestId": "$.tasks[0].id",
    "cost": "$.cost"
  },
  "sections": [
    { "id": "serp", "kind": "elements", "path": "$.tasks[0].result[0].items[*]",
      "discriminator": "type",
      "discriminatorMap": {
        "organic": "item:organic", "paid": "item:paid",
        "featured_snippet": "feature:featured_snippet", "knowledge_graph": "feature:knowledge_panel", "people_also_ask": "feature:people_also_ask"
      },
      "position": "fields",
      "fields": {
        "rankInGroup": { "from": "rank_group", "convert": "int" },
        "rankAbsolute": { "from": "rank_absolute", "convert": "int" }
      },
      "fieldsByType": {
        "organic": { "title": "title", "url": "url", "snippet": "description", "domain": "domain", "displayUrl": "breadcrumb" },
        "paid":    { "title": "title", "url": "url", "snippet": "description", "domain": "domain", "displayUrl": "breadcrumb" },
        "featured_snippet": { "title": "title", "text": "description", "sourceUrl": "url" }
      } }
  ]
}
